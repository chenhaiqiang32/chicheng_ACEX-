  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mlightcad/cad-html-exporter": "1.7.8",
    "@mlightcad/data-model": "1.15.21",
    "@napi-rs/canvas": "^1.1.0",
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "optionalDependencies": {
    "@mlightcad/dwg-converter": "https://npm.pkg.github.com/download/@mlightcad/dwg-converter/1.15.21/3db2e75205e2abaf36d9dc3c87e6a65baabeb4b1"
  },
  "overrides": {
    "@mlightcad/data-model": "1.15.21"
  }
}
