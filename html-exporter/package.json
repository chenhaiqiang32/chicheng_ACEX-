{
  "name": "acex-html-exporter-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ACEX DWG/DXF → multi zip 转换服务（可单独部署到 Windows）",
  "scripts": {
    "postinstall": "node scripts/sync-cad-data.mjs",
    "sync:cad-data": "node scripts/sync-cad-data.mjs",
    "convert": "node scripts/convert.mjs",
